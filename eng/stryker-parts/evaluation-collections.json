      "Evaluation/OptionalOrPlanNode.cs",
      "Evaluation/RecordPlanNode.cs",
      "Evaluation/ValueRecord.cs",
      "Evaluation/UnknownPattern.cs",
      "Evaluation/PartialState.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 80,
      "break": 80
    }
  }
}
