{
  "stryker-config": {
    "project": "src/Great.Parts.Cel/Great.Parts.Cel.csproj",
    "test-projects": [
      "../../tests/Great.Parts.Cel.Tests/Great.Parts.Cel.Tests.csproj",
      "../../tests/Great.Parts.Cel.Properties/Great.Parts.Cel.Properties.csproj",
      "../../tests/Great.Parts.Cel.Conformance/Great.Parts.Cel.Conformance.csproj"
    ],
    "target-framework": "net11.0",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "reporters": ["json", "progress"],
    "mutation-level": "Standard",
    "since": {
      "enabled": true,
      "target": "main"
    },
    "mutate": [
      "Syntax/Printer.cs",
      "Syntax/Lexer.cs",
      "Syntax/SyntaxTreeComparer.cs",
      "Syntax/NodeFactory.cs",
      "Syntax/StructEntry.cs",
      "Syntax/StructNode.cs",
      "Syntax/CallNode.cs",
      "Syntax/SelectNode.cs",
      "Syntax/ListNode.cs",
      "Syntax/ConstantNode.cs",
      "Syntax/IdentNode.cs",
      "Syntax/ExprNode.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 80,
      "break": 80
    }
  }
}
