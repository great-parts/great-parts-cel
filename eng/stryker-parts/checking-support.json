{
  "stryker-config": {
    "project": "src/Great.Parts.Cel/Great.Parts.Cel.csproj",
    "test-projects": [
      "../../tests/Great.Parts.Cel.Tests/Great.Parts.Cel.Tests.csproj",
      "../../tests/Great.Parts.Cel.Properties/Great.Parts.Cel.Properties.csproj",
      "../../tests/Great.Parts.Cel.Conformance/Great.Parts.Cel.Conformance.csproj"
    ],
    "target-framework": "net11.0",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "reporters": ["json", "progress"],
    "mutation-level": "Standard",
    "since": {
      "enabled": true,
      "target": "main"
    },
    "mutate": [
      "Checking/CelCheckedExpr.cs",
      "Checking/CelReference.cs",
      "Checking/CheckedExpression.cs",
      "Checking/CheckErrors.cs",
      "Checking/CheckResult.cs",
      "Checking/DeclarationIndex.cs",
      "Checking/EnvironmentDescription.cs",
      "Checking/Reference.cs",
      "Checking/ReferencedNames.cs",
      "Configuration/CelEnvironmentJson.cs",
      "Configuration/JsonPositions.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 80,
      "break": 80
    }
  }
}
