<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The repository's own checks: reads the files of the repository, reports and the git history and writes every finding
    as one line of the common form (docs/design/eng-checks.md). Not packed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Great.Parts.Cel.Eng.Checks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- C# syntax for the checks of sources: suppressions, duplicates, examples. Parsed without a compilation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../findings/Great.Parts.Cel.Eng.Findings.csproj" />
  </ItemGroup>

  <!-- The tests of eng/tests run the commands and Program in their own process. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Eng.Tests" />
  </ItemGroup>

</Project>
