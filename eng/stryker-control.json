{
  "stryker-config": {
    "project": "eng/checks/Great.Parts.Cel.Eng.Checks.csproj",
    "test-projects": [
      "eng/tests/Great.Parts.Cel.Eng.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "reporters": ["json", "progress"],
    "mutation-level": "Standard",
    "since": {
      "enabled": false
    },
    "mutate": [
      "Commands/DuplicatesCommand.cs",
      "Commands/RatchetCommand.cs",
      "Commands/SuppressionsCommand.cs",
      "Repository/RepositoryRoot.cs",
      "Suppressions/SuppressionScan.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    }
  }
}
