{
  "name": "difftest",
  "description": "Run manifest of eng/difftest: the extension sets and the variables of the profile",
  "container": "gp.test",
  "extensions": [
    { "name": "strings", "version": "5" },
    { "name": "math", "version": "3" },
    { "name": "lists", "version": "4" },
    { "name": "sets", "version": "0" },
    { "name": "encoders", "version": "1" },
    { "name": "bindings", "version": "1" },
    { "name": "two-var-comprehensions", "version": "0" },
    { "name": "network", "version": "1" },
    { "name": "optional", "version": "2" }
  ],
  "variables": [
    { "name": "i1", "type_name": "int" },
    { "name": "i2", "type_name": "int" },
    { "name": "u1", "type_name": "uint" },
    { "name": "d1", "type_name": "double" },
    { "name": "b1", "type_name": "bool" },
    { "name": "b2", "type_name": "bool" },
    { "name": "s1", "type_name": "string" },
    { "name": "y1", "type_name": "bytes" },
    { "name": "x1", "type_name": "dyn" },
    { "name": "x2", "type_name": "dyn" },
    { "name": "li", "type": "list<int>" },
    { "name": "ls", "type": "list<string>" },
    { "name": "lx", "type": "list<dyn>" },
    { "name": "ms", "type": "map<string, int>" },
    { "name": "mx", "type": "map<int, dyn>" },
    { "name": "wi", "type_name": "int_wrapper" },
    { "name": "gp.q", "type_name": "int" },
    { "name": "gp.test.r", "type_name": "string" }
  ]
}
