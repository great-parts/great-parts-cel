<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The commands of eng/ that run in the container (test, mutate, difftest and min-sdk). The project has no packages and no
    check logic: it runs steps as child processes, in parallel lanes where a command allows it; only min-sdk has steps in C#.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Great.Parts.Cel.Eng.Run</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The form of the budget of eng/difftest: one file in the repository, so the limit of the run is read as the program reads it. -->
  <ItemGroup>
    <Compile Include="../difftest/BudgetText.cs" Link="BudgetText.cs" />
  </ItemGroup>

  <!-- The tests of eng/tests run the steps and the time limits in their own process. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Eng.Tests" />
  </ItemGroup>

</Project>
