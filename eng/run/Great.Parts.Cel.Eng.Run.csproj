<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The steps of the commands of eng/ that run in the container (test, and later test-aot, docs, mutate
    and difftest). The project has no packages and no check logic: it runs steps as child processes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Great.Parts.Cel.Eng.Run</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
