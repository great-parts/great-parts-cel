<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The packed Great.Parts.Cel of artifacts/packages is the only package source. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
  </packageSources>
  <!--
    Every local build packs the version 0.0.0-dev and NuGet does not look at the source again for a version that its
    packages folder has, so the application has its own folder, which the service min-sdk deletes before a run.
  -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/min-sdk/packages" />
  </config>
</configuration>
