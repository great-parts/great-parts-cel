<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the repository's own checks on violating examples (docs/design/eng-tests.md). The project runs under JIT
    only: the rules of the architecture analyzer run in memory on Roslyn, which Native AOT cannot load.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Great.Parts.Cel.Eng.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <!-- The rules of the architecture analyzer, run in memory as a library. -->
  <ItemGroup>
    <ProjectReference Include="../analyzers/Great.Parts.Cel.Eng.Analyzers.csproj" />
    <!-- The commands and Program of eng/checks run in the test process; Finding and EngCodes come through it. -->
    <ProjectReference Include="../checks/Great.Parts.Cel.Eng.Checks.csproj" />
    <!-- The generator, the manifest check and Program of eng/difftest run in the test process. -->
    <ProjectReference Include="../difftest/Great.Parts.Cel.Eng.Difftest.csproj" />
    <!-- The steps, the time limits and the arguments of eng/run run in the test process. -->
    <ProjectReference Include="../run/Great.Parts.Cel.Eng.Run.csproj" />
    <!-- The readers, the model, the output and Program of the generator of the Unicode tables run in the test process. -->
    <ProjectReference Include="../unicode/Great.Parts.Cel.Eng.Unicode.csproj" />
  </ItemGroup>

</Project>
