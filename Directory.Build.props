<Project>
  <!--
    Strict checks for every C# project of the repository: the library, the source generator,
    tests and eng/. Generated code (the obj/ directory and what Roslyn treats as generated) is not
    checked. A rule is turned off only with a reason next to it; outside the directories listed in
    docs/design/eng-checks-source.md, marking code as generated turns rules off too and needs a reason.
  -->
  <PropertyGroup>
    <!-- Nullable reference types; a possible null dereference is a build error. -->
    <Nullable>enable</Nullable>
    <!-- Every warning is a build error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- All .NET code analysis rules. -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Code style rules run in the build; their levels are set in .editorconfig. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- XML documentation; a public member without it (CS1591) is a build error in package projects. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The language version is the default of each target framework; the SDK version is pinned in global.json. -->
    <!-- Packages restore from lock files; continuous integration restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- License of every package of the repository, written to the package metadata as an SPDX expression. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Copyright line of every package of the repository, written to the package metadata and the assemblies. -->
    <Copyright>Copyright 2026 The Great.Parts Authors</Copyright>
    <!-- Version of a local build; release.yml passes the version of the tag with -p:Version. Both packages have one version. -->
    <Version>0.0.0-dev</Version>
    <!-- Package metadata shared by all packages; Title and Description are set in each project (docs/design/eng-release.md, "Package metadata"). -->
    <Authors>The Great.Parts Authors</Authors>
    <!-- The same name goes to the attributes of the assemblies (company and product), so a file of a package shows who made what. -->
    <Company>The Great.Parts Authors</Company>
    <Product>Great.Parts.Cel</Product>
    <!-- The language of the texts of the packages and of the neutral resources of the assemblies. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The license is accepted by using the package: the client shows no prompt (the default, written down on purpose). -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/great-parts/great-parts-cel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/great-parts/great-parts-cel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The repository URL goes to the package metadata and to the source link of the symbols. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Source Link: the source files that git does not track, such as generated ones, go into the portable PDBs of the symbol package. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageTags>cel;common-expression-language;expression;expressions;expression-evaluator;rules;rules-engine;cel-spec;csharp;validation;dotnet;nativeaot;source-generator</PackageTags>
    <!-- The README of a package is the file README.md in its root; each package project adds the file eng/packages/<package id>.README.md under this name. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Release notes of a package: the entry of its version in CHANGELOG.md at the tag of the release (the tag is v and the version). -->
    <PackageReleaseNotes>The changes of this release are listed in $(RepositoryUrl)/blob/v$(Version)/CHANGELOG.md</PackageReleaseNotes>
    <!-- A symbol package .snupkg is written next to every .nupkg. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The icon of the package: the file eng/packages/icon.png, in the root of the package under the name icon.png. The two
    groups apply only when the file exists, so the build stays valid before the file is added; the file is added together with
    the line `file icon.png` in both lists of eng/packages (docs/design/eng-release.md, "Package icon").
  -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)eng/packages/icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)eng/packages/icon.png')">
    <None Include="$(MSBuildThisFileDirectory)eng/packages/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Thresholds of the code metrics rules (CA1502 and others). -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>

  <!--
    The architecture analyzer (docs/design/eng-analyzers.md) runs in every C# project except its own. It is a build-time
    reference only and never becomes a dependency of a package.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Great.Parts.Cel.Eng.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)eng/analyzers/Great.Parts.Cel.Eng.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The layer table of the namespaces, read by the architecture analyzer in the projects under src/. -->
  <ItemGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/layers.txt" />
  </ItemGroup>

  <!--
    An invalid line of CodeMetricsConfig.txt is CA1509 and a build error. The diagnostic is reported in that file,
    not in a source file, so .editorconfig does not set its severity and the rule stays silent without this property.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CA1509</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
