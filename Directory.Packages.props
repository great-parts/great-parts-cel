<Project>
  <!-- Package versions are managed centrally; every project restores from its lock file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <!-- The lower bound in the package of Great.Parts.Cel.Protobuf; applications can use a later version. -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <!-- Build-time tool of the suite runner: protoc and the compiler of the C# messages. -->
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <!-- The Blazor WebAssembly application of the browser-wasm check: the package of the target framework of the application. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- The compiler version of the .NET SDK 10.0.404: the analyzer and the source generator load in that compiler and newer. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!--
      The lower bounds in the package of Great.Parts.Cel.DependencyInjection, one for both target frameworks, so that an
      application on .NET 10 is not made to raise its version; applications can use a later version.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="xunit.v3.aot" Version="4.0.3" />
  </ItemGroup>
</Project>
