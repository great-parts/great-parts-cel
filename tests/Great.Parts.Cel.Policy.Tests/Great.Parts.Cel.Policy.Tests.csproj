<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the policy package (docs/design/tests.md). The tests run under JIT and as a published Native AOT executable; the same
    tests must run in both modes. InvariantGlobalization is set on the publish command line only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Policy.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Restore is the same for JIT and Native AOT, so publishing does not change the lock file. -->
    <PublishAot>true</PublishAot>
    <!-- Only the publish runs without dynamic code; the JIT run tests the library with it (as in Great.Parts.Cel.Tests). -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!-- The publish names linux-x64 with -r; the runtime identifier of the host would change the locked restore (NU1004). -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <!-- The published test executable needs no XML documentation (MSB3030 otherwise). -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel.Policy/Great.Parts.Cel.Policy.csproj" />
  </ItemGroup>

  <!-- The whole assembly of the package is a root of the Native AOT publish, so the publish analyzes all its public code. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Great.Parts.Cel.Policy" />
  </ItemGroup>

</Project>
