<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Property tests of the library (docs/design/tests.md). They run under JIT only. The seed of every property is
    PropertySettings.Seed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Properties</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
  </ItemGroup>

</Project>
