<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the library (docs/design/tests.md). The tests run under JIT and as a published Native AOT executable;
    the same tests must run in both modes. InvariantGlobalization is set on the publish command line only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Restore is the same for JIT and Native AOT, so publishing does not change the lock file. -->
    <PublishAot>true</PublishAot>
    <!--
      With PublishAot the Native AOT targets set DynamicCodeSupport=false for every build, and the SDK writes it into runtimeconfig.json:
      the JIT run of the tests would be a run without dynamic code, as the published one, and would not test the library with it.
      Only the publish keeps false; dotnet publish sets _IsPublishing.
    -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!--
      With PublishAot the SDK adds the runtime identifier of the host to RuntimeIdentifiers (osx-arm64 on a macOS runner), which
      changes the restore and fails a locked restore with NU1004. The publish names linux-x64 with -r, so no default is needed.
    -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <!--
      The published test executable needs no XML documentation. Without this, publishing under Native AOT fails with
      MSB3030: the build output is not copied to bin/ and the publish step looks for the documentation file there.
    -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
  </ItemGroup>

</Project>
