<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests of the library (docs/design/tests.md). The tests run under JIT and as a published Native AOT executable;
    the same tests must run in both modes. InvariantGlobalization is set on the publish command line only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Restore is the same for JIT and Native AOT, so publishing does not change the lock file. -->
    <PublishAot>true</PublishAot>
    <!--
      With PublishAot the Native AOT targets set DynamicCodeSupport=false for every build, and the SDK writes it into runtimeconfig.json:
      the JIT run of the tests would be a run without dynamic code, as the published one, and would not test the library with it.
      Only the publish keeps false; dotnet publish sets _IsPublishing.
    -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!--
      With PublishAot the SDK adds the runtime identifier of the host to RuntimeIdentifiers (osx-arm64 on a macOS runner), which
      changes the restore and fails a locked restore with NU1004. The publish names linux-x64 with -r, so no default is needed.
    -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <!--
      The published test executable needs no XML documentation. Without this, publishing under Native AOT fails with
      MSB3030: the build output is not copied to bin/ and the publish step looks for the documentation file there.
    -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Build-time tool only: it compiles the .proto files and gives the build the protoc program; it is not a dependency. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <!-- The reference of the Unicode tables that Go writes, and the version the tables are generated for (Regex/UnicodeTablesTests). -->
  <ItemGroup>
    <Content Include="../../eng/unicode/reference/go-1.27.3.txt" Link="Regex/Data/go-1.27.3.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../eng/unicode/inputs.txt" Link="Regex/Data/unicode-inputs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The search tests of RE2 as Go 1.27.3 keeps them, which Regex/Re2SearchCorpusTests reads as a file next to the test assembly. -->
  <ItemGroup>
    <Content Include="Regex/Data/re2-search.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The records of the overloads of version 1 of the standard library and of each version of the extension sets, which Library/LibrarySnapshotTests compares with the tables. -->
  <ItemGroup>
    <Content Include="Library/Snapshots/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Protobuf/Great.Parts.Cel.Protobuf.csproj" />
    <!-- The types of the generator samples and their type contexts; the Native AOT publication takes the library with it (docs/design/generator.md, "Test projects"). -->
    <ProjectReference Include="../Great.Parts.Cel.Generator.Samples/Great.Parts.Cel.Generator.Samples.csproj" />
  </ItemGroup>

  <!--
    The test messages of the pinned cel-spec (proto2 and proto3 TestAllTypes and the proto2 extensions) compile into C# classes,
    namespaces Cel.Expr.Conformance.Proto2 and Cel.Expr.Conformance.Proto3, for the tests of the protobuf package
    (docs/design/protobuf.md, "Projects and test messages"). No gRPC services.
  -->
  <PropertyGroup>
    <CelProtoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'tests', 'cel-spec', 'proto'))</CelProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto2/test_all_types.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto2/test_all_types_extensions.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto3/test_all_types.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
  </ItemGroup>

  <!-- The time zone data of the tests: one copy of the file and its reader, kept in the suite runner (docs/design/tests.md, "Time zone data"). -->
  <ItemGroup>
    <Compile Include="../Great.Parts.Cel.Conformance/Runner/ZoneInfoFile.cs" Link="ZoneInfo/ZoneInfoFile.cs" />
    <EmbeddedResource Include="../Great.Parts.Cel.Conformance/ZoneInfo/zoneinfo.zip" Link="ZoneInfo/zoneinfo.zip" LogicalName="tests/Great.Parts.Cel.Conformance/ZoneInfo/zoneinfo.zip" />
  </ItemGroup>

</Project>
