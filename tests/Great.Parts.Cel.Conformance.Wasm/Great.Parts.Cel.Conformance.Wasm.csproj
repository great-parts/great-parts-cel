<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The cel-spec suite on browser-wasm (S-9, R-1): the runner of tests/Great.Parts.Cel.Conformance as a console application of the
    runtime for WebAssembly. It is published in the default mode (the interpreter of the runtime, IL trimming, no AOT compilation to
    WebAssembly) and runs under Node.js in a container (eng/wasm/run.sh). The sources of the runner and the data are the ones of the
    suite project, linked; nothing is copied.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <!--
      The library lets the assembly named Great.Parts.Cel.Conformance see its internal members (InternalsVisibleTo): the runner
      calls the internal entry points of the cases without a type check. This assembly is that runner on another platform.
    -->
    <AssemblyName>Great.Parts.Cel.Conformance</AssemblyName>
    <RootNamespace>Great.Parts.Cel.Conformance</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The default publish mode of the application: IL trimming on, no AOT compilation to WebAssembly. -->
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Build-time tool only: it compiles the .proto files and gives the build the protoc program; it is not a dependency. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Protobuf/Great.Parts.Cel.Protobuf.csproj" />
    <ProjectReference Include="../../eng/findings/Great.Parts.Cel.Eng.Findings.csproj" />
  </ItemGroup>

  <!-- The sources of the runner of the suite project: all but SuiteAssert.cs, which needs xUnit. -->
  <ItemGroup>
    <Compile Include="../Great.Parts.Cel.Conformance/Runner/*.cs" Exclude="../Great.Parts.Cel.Conformance/Runner/SuiteAssert.cs" Link="Runner/%(Filename)%(Extension)" />
    <Compile Include="../Great.Parts.Cel.Conformance/CelSpec/CelSpecSuite.cs" Link="CelSpec/CelSpecSuite.cs" />
  </ItemGroup>

  <!-- The messages of the cel-spec suite and the test messages, as in the suite project. -->
  <PropertyGroup>
    <CelRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</CelRepoRoot>
    <!-- Without a trailing separator: a trailing backslash would escape the closing quote of a command line. -->
    <CelProtoDir>$(CelRepoRoot)tests/cel-spec/proto</CelProtoDir>
    <CelProtoRoot>$([MSBuild]::NormalizeDirectory('$(CelRepoRoot)', 'tests', 'cel-spec', 'proto'))</CelProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(CelProtoRoot)cel/expr/syntax.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/checked.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/eval.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/value.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/test/simple.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto2/test_all_types.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto2/test_all_types_extensions.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/proto3/test_all_types.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
  </ItemGroup>

  <!--
    Data of the suite, embedded as in the suite project: every item is an embedded resource named by its path from the repository
    root, with forward slashes; a text file is embedded as it is and, encoded by protoc, as <path without extension>.binpb.
    The cases are those of tests/simple/testdata of the pinned cel-spec commit; the regression corpus is not run here.
  -->
  <PropertyGroup>
    <!-- Per target framework and configuration, so that the builds of the two targets never write the same file. -->
    <CelSpecObj>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/celspec/</CelSpecObj>
    <CelSpecStamp>$(CelSpecObj)encoded.stamp</CelSpecStamp>
  </PropertyGroup>

  <ItemGroup>
    <CelSuiteText Include="../cel-spec/tests/simple/testdata/*.textproto"
                  RepoPath="$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/'))"
                  BinaryRepoPath="$([System.IO.Path]::ChangeExtension($([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/')), '.binpb'))"
                  EncodedPath="$(CelSpecObj)$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/').Replace('/', '__')).binpb" />
    <CelSuiteFile Include="../Great.Parts.Cel.Conformance/CelSpec/skips.md;../cel-spec/COMMIT"
                  RepoPath="$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/'))" />
    <CelProtoSource Include="$(CelProtoRoot)**/*.proto" />
    <EmbeddedResource Include="@(CelSuiteText);@(CelSuiteFile)" LogicalName="%(RepoPath)" />
    <!-- The time zone data of the tests: the archive of the suite project, under the same name. -->
    <EmbeddedResource Include="../Great.Parts.Cel.Conformance/ZoneInfo/zoneinfo.zip" LogicalName="tests/Great.Parts.Cel.Conformance/ZoneInfo/zoneinfo.zip" />
  </ItemGroup>

  <!--
    protoc reads each text file as a cel.expr.conformance.test.SimpleTestFile and writes the binary form. Expanded Any values and
    extensions resolve only when the test messages are inputs too. The stamp file is written after every file is encoded, so a failed
    run never looks up to date.
  -->
  <Target Name="EncodeCelSpecData"
          DependsOnTargets="Protobuf_ResolvePlatform"
          Inputs="@(CelSuiteText);@(CelProtoSource);$(MSBuildProjectFullPath)"
          Outputs="$(CelSpecStamp)">
    <MakeDir Directories="$(CelSpecObj)" />
    <PropertyGroup>
      <CelStandardImports>$(Protobuf_StandardImportsPath.TrimEnd('\').TrimEnd('/'))</CelStandardImports>
      <CelEncodeCommand>"$(Protobuf_ProtocFullPath)" --encode=cel.expr.conformance.test.SimpleTestFile -I"$(CelProtoDir)" -I"$(CelStandardImports)"</CelEncodeCommand>
      <CelEncodeInputs>"$(CelProtoDir)/cel/expr/conformance/test/simple.proto" "$(CelProtoDir)/cel/expr/conformance/proto2/test_all_types.proto" "$(CelProtoDir)/cel/expr/conformance/proto3/test_all_types.proto" "$(CelProtoDir)/cel/expr/conformance/proto2/test_all_types_extensions.proto"</CelEncodeInputs>
    </PropertyGroup>
    <Exec Command="$(CelEncodeCommand) $(CelEncodeInputs) &lt; &quot;%(CelSuiteText.FullPath)&quot; &gt; &quot;%(CelSuiteText.EncodedPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <WriteLinesToFile File="$(CelSpecStamp)" Lines="encoded" Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="@(CelSuiteText->'%(EncodedPath)')" />
      <FileWrites Include="$(CelSpecStamp)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedCelSpecData" DependsOnTargets="EncodeCelSpecData" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="%(CelSuiteText.EncodedPath)" LogicalName="%(CelSuiteText.BinaryRepoPath)" />
    </ItemGroup>
  </Target>

</Project>
