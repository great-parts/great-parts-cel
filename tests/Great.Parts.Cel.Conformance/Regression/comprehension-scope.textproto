# Minimized cases of known divergences from cel-go in type checking inside a comprehension. The expectation of each case is the answer of cel-go.

name: "comprehension_scope"
description: "Ordering across numeric types inside the body of a macro"
section {
  name: "cross_type_ordering"
  description: "cel-go drops the filter of the overloads of ordering across int, uint and double when its checker enters the scope of a comprehension, so it accepts inside the body of a macro what it refuses outside; the language definition requires strict types when the expression is checked, and the library refuses it everywhere"
  test {
    name: "optional_body"
    description: "comprehension(optional_type) we-error"
    expr: "optional.none().optMap(x, 1 >= 1.5).hasValue()"
    value: {
      bool_value: false
    }
  }
}
