        values: {
          int64_value: 11
        }
        values: {
          int64_value: 1
        }
      }
    }
  }
  test {
    name: "timestamp_keys"
    description: "list_google.protobuf.Timestamp_sortByAssociatedKeys(list, list) value-mismatch"
    expr: "lists.range(13).sortBy(i, timestamp(i % 2))"
    value: {
