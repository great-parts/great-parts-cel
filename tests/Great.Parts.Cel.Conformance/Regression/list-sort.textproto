section {
  name: "sort_with_nan"
  description: "sort of 13 doubles with a NaN: cel-go leaves the NaN after 9, the library merges and leaves it elsewhere; the map turns the NaN into 0.0, which a case cannot expect as itself"
  test {
    name: "double_nan"
    description: "list_double_sort(list) value-mismatch"
    expr: "[5.0, 0.0 / 0.0, 4.0, 3.0, 2.0, 1.0, 9.0, 8.0, 7.0, 6.0, 10.0, 12.0, 11.0].sort().map(x, x != x ? 0.0 : x)"
    value: {
      list_value: {
        values: {
          double_value: 1
        }
        values: {
          double_value: 2
        }
        values: {
          double_value: 3
        }
        values: {
          double_value: 4
        }
        values: {
          double_value: 5
        }
        values: {
          double_value: 6
        }
        values: {
          double_value: 7
        }
        values: {
          double_value: 8
        }
        values: {
          double_value: 9
        }
        values: {
          double_value: 0
        }
        values: {
          double_value: 10
        }
        values: {
          double_value: 11
        }
        values: {
          double_value: 12
        }
      }
    }
  }
}
