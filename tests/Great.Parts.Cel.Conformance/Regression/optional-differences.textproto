        message: "invalid qualifier type: *types.baseMap"
      }
    }
  }
  test {
    name: "null"
    description: "optional_map_index_value(optional_type(map), null_type) we-value"
    expr: "optional.of({'a': 1})[dyn(null)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: types.Null"
      }
    }
  }
  test {
    name: "type"
    description: "optional_map_index_value(optional_type(map), type) we-value"
    expr: "optional.of({'a': 1})[dyn(int)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.Type"
      }
    }
  }
}
section {
  name: "key_kind_optindex_of_map"
  description: "A key of a kind that no map holds, in the index [? ] of a map: the library gives the empty optional, cel-go fails with invalid qualifier type"
  test {
    name: "bytes"
    description: "map_optindex_optional_value(map, bytes) we-value"
    expr: "{'a': 1}[?dyn(b'a')].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: types.Bytes"
      }
    }
  }
  test {
    name: "list"
    description: "map_optindex_optional_value(map, list) we-value"
    expr: "{'a': 1}[?dyn([1])].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.baseList"
      }
    }
  }
  test {
    name: "map"
    description: "map_optindex_optional_value(map, map) we-value"
    expr: "{'a': 1}[?dyn({'a': 1})].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.baseMap"
      }
    }
  }
  test {
    name: "null"
    description: "map_optindex_optional_value(map, null_type) we-value"
    expr: "{'a': 1}[?dyn(null)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: types.Null"
      }
    }
  }
  test {
    name: "type"
    description: "map_optindex_optional_value(map, type) we-value"
    expr: "{'a': 1}[?dyn(int)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.Type"
      }
    }
  }
}
