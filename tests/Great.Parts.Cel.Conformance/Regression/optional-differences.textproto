# Minimized cases of known divergences from cel-go in the optional extension set. The expectation of each case is the answer of cel-go.

name: "optional_differences"
description: "Presence of a field of an empty optional, the right part of or that is not an optional, and the key of an index of an optional or of a map"
section {
  name: "presence"
  description: "has() of a selection from an empty optional: cel-go fails with a missing key, the library returns false, as the cel-spec case optionals/optionals/map_optional_select_has expects"
  test {
    name: "has_empty_optional"
    description: "has(optional_type) we-value"
    expr: "has({'foo': optional.none()}.foo.bar)"
    eval_error: {
      errors: {
        message: "no such key: bar"
      }
    }
  }
}
section {
  name: "or_right_kind"
  description: "or with an empty left part returns the right part as it is in cel-go, whatever its kind; the library fails the call, since no overload takes an argument that is not an optional"
  test {
    name: "bool"
    description: "optional_or_optional(optional_type, bool) we-error"
    expr: "optional.none().or(dyn(true))"
    value: {
      bool_value: true
    }
  }
  test {
    name: "bytes"
    description: "optional_or_optional(optional_type, bytes) we-error"
    expr: "optional.none().or(dyn(b'a'))"
    value: {
      bytes_value: "a"
    }
  }
  test {
    name: "double"
    description: "optional_or_optional(optional_type, double) we-error"
    expr: "optional.none().or(dyn(1.5))"
    value: {
      double_value: 1.5
    }
  }
  test {
    name: "duration"
    description: "optional_or_optional(optional_type, duration) we-error"
    expr: "optional.none().or(dyn(duration('1s')))"
    value: {
      object_value {
        [type.googleapis.com/google.protobuf.Duration] {
          seconds: 1
        }
      }
    }
  }
  test {
    name: "int"
    description: "optional_or_optional(optional_type, int) we-error"
    expr: "optional.none().or(dyn(1))"
    value: {
      int64_value: 1
    }
  }
  test {
    name: "list"
    description: "optional_or_optional(optional_type, list) we-error"
    expr: "optional.none().or(dyn([1]))"
    value: {
      list_value {
        values {
          int64_value: 1
        }
      }
    }
  }
  test {
    name: "map"
    description: "optional_or_optional(optional_type, map) we-error"
    expr: "optional.none().or(dyn({'a': 1}))"
    value: {
      map_value {
        entries {
          key {
            string_value: "a"
          }
          value {
            int64_value: 1
          }
        }
      }
    }
  }
  test {
    name: "null"
    description: "optional_or_optional(optional_type, null_type) we-error"
    expr: "optional.none().or(null)"
    value: {
      null_value: NULL_VALUE
    }
  }
  test {
    name: "string"
    description: "optional_or_optional(optional_type, string) we-error"
    expr: "optional.none().or(dyn('a'))"
    value: {
      string_value: "a"
    }
  }
  test {
    name: "timestamp"
    description: "optional_or_optional(optional_type, timestamp) we-error"
    expr: "optional.none().or(dyn(timestamp(0)))"
    value: {
      object_value {
        [type.googleapis.com/google.protobuf.Timestamp] {
        }
      }
    }
  }
  test {
    name: "type"
    description: "optional_or_optional(optional_type, type) we-error"
    expr: "optional.none().or(dyn(int))"
    value: {
      type_value: "int"
    }
  }
  test {
    name: "uint"
    description: "optional_or_optional(optional_type, uint) we-error"
    expr: "optional.none().or(dyn(1u))"
    value: {
      uint64_value: 1
    }
  }
}
section {
  name: "index_error_key"
  description: "The key of an index of an empty optional is evaluated by the library, as every argument is, and its error is the result; cel-go does not evaluate it and returns the empty optional"
  test {
    name: "index"
    description: "_[_](optional_type, error) we-error"
    expr: "optional.none()[dyn(1) / 0].hasValue()"
    value: {
      bool_value: false
    }
  }
  test {
    name: "optindex"
    description: "_[?_](optional_type, error) we-error"
    expr: "optional.none()[?dyn(1) / 0].hasValue()"
    value: {
      bool_value: false
    }
  }
}
section {
  name: "key_kind_index_of_optional_dyn"
  description: "A key of a kind that no map holds, in the index [ ] of an optional that holds a map under dyn: the library gives the empty optional, cel-go fails with invalid qualifier type"
  test {
    name: "bytes"
    description: "optional_map_index_value(optional_type, bytes) we-value"
    expr: "optional.of(dyn({'a': 1}))[dyn(b'a')].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: types.Bytes"
      }
    }
  }
  test {
    name: "list"
    description: "optional_map_index_value(optional_type, list) we-value"
    expr: "optional.of(dyn({'a': 1}))[dyn([1])].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.baseList"
      }
    }
  }
  test {
    name: "map"
    description: "optional_map_index_value(optional_type, map) we-value"
    expr: "optional.of(dyn({'a': 1}))[dyn({'a': 1})].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.baseMap"
      }
    }
  }
  test {
    name: "null"
    description: "optional_map_index_value(optional_type, null_type) we-value"
    expr: "optional.of(dyn({'a': 1}))[dyn(null)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: types.Null"
      }
    }
  }
  test {
    name: "type"
    description: "optional_map_index_value(optional_type, type) we-value"
    expr: "optional.of(dyn({'a': 1}))[dyn(int)].hasValue()"
    eval_error: {
      errors: {
        message: "invalid qualifier type: *types.Type"
      }
    }
  }
}
section {
  name: "key_kind_index_of_optional_map"
  description: "A key of a kind that no map holds, in the index [ ] of an optional of a map: the library gives the empty optional, cel-go fails with invalid qualifier type"
