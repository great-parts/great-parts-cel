  test {
    name: "greater_string_double"
    description: "_>_(string, double) we-error"
    expr: "dyn('a') > 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_bytes_double"
    description: "_>_(bytes, double) we-error"
    expr: "dyn(b'a') > 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_timestamp_double"
    description: "_>_(timestamp, double) we-error"
    expr: "dyn(timestamp(0)) > 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_duration_double"
    description: "_>_(duration, double) we-error"
