section {
  name: "nan_second"
  description: "A bool, string, bytes, timestamp or duration value before a NaN double: ordering is not defined across the kinds; cel-go returns false"
  test {
    name: "less_bool_double"
    description: "_<_(bool, double) we-error"
    expr: "dyn(true) < 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "less_string_double"
    description: "_<_(string, double) we-error"
    expr: "dyn('a') < 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "less_bytes_double"
    description: "_<_(bytes, double) we-error"
    expr: "dyn(b'a') < 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "less_timestamp_double"
    description: "_<_(timestamp, double) we-error"
    expr: "dyn(timestamp(0)) < 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "less_duration_double"
    description: "_<_(duration, double) we-error"
    expr: "dyn(duration('1s')) < 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "less_equals_bool_double"
    description: "_<=_(bool, double) we-error"
    expr: "dyn(true) <= 0.0 / 0.0"
    value: {
      bool_value: false
