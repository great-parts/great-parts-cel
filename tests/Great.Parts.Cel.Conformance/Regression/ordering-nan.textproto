    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_equals_string_double"
    description: "_>=_(string, double) we-error"
    expr: "dyn('a') >= 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_equals_bytes_double"
    description: "_>=_(bytes, double) we-error"
    expr: "dyn(b'a') >= 0.0 / 0.0"
    value: {
      bool_value: false
    }
  }
  test {
    name: "greater_equals_timestamp_double"
    description: "_>=_(timestamp, double) we-error"
