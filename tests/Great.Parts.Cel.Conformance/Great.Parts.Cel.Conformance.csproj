<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Suite runner of the library (docs/design/conformance.md): the cel-spec suite and the regression corpus. It runs under JIT
    and as a published Native AOT executable; the same tests must run in both modes. InvariantGlobalization is set on the
    publish command line only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Conformance</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Restore is the same for JIT and Native AOT, so publishing does not change the lock file. -->
    <PublishAot>true</PublishAot>
    <!--
      With PublishAot the Native AOT targets set DynamicCodeSupport=false for every build, and the SDK writes it into runtimeconfig.json:
      the JIT run would be a run without dynamic code, as the published one, and the runner would name its cell native-aot.
      Only the publish keeps false; dotnet publish sets _IsPublishing.
    -->
    <DynamicCodeSupport Condition="'$(_IsPublishing)' != 'true'">true</DynamicCodeSupport>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!--
      With PublishAot the SDK adds the runtime identifier of the host to RuntimeIdentifiers (osx-arm64 on a macOS runner), which
      changes the restore and fails a locked restore with NU1004. The publish names linux-x64 with -r, so no default is needed.
    -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <!--
      The published test executable needs no XML documentation. Without this, publishing under Native AOT fails with
      MSB3030: the build output is not copied to bin/ and the publish step looks for the documentation file there.
    -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tests have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Test method names are <Situation>_<Expectation>, with an underscore. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Build-time tool only: it compiles the .proto files and gives the build the protoc program; it is not a dependency. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../eng/findings/Great.Parts.Cel.Eng.Findings.csproj" />
  </ItemGroup>

  <!--
    The messages of the cel-spec suite: simple.proto and its imports compile into C# classes, namespace Cel.Expr. No gRPC services.
    The test messages (proto2 and proto3 TestAllTypes) are inputs of the textproto encoding below, not of the C# code.
  -->
  <PropertyGroup>
    <CelRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</CelRepoRoot>
    <!-- Without a trailing separator: a trailing backslash would escape the closing quote of a command line. -->
    <CelProtoDir>$(CelRepoRoot)tests/cel-spec/proto</CelProtoDir>
    <CelProtoRoot>$([MSBuild]::NormalizeDirectory('$(CelRepoRoot)', 'tests', 'cel-spec', 'proto'))</CelProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(CelProtoRoot)cel/expr/syntax.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/checked.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/eval.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/value.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(CelProtoRoot)cel/expr/conformance/test/simple.proto" ProtoRoot="$(CelProtoRoot)" GrpcServices="None" />
  </ItemGroup>

  <!--
    Data of the suites. The runner reads no files: every item is an embedded resource named by its path from the repository
    root, with forward slashes. A text file of a suite is embedded as it is and, encoded by protoc, as <path without extension>.binpb.
  -->
  <PropertyGroup>
    <!-- Per target framework and configuration, so that the builds of the two targets never write the same file. -->
    <CelSpecObj>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/celspec/</CelSpecObj>
    <CelSpecStamp>$(CelSpecObj)encoded.stamp</CelSpecStamp>
  </PropertyGroup>

  <ItemGroup>
    <CelSuiteText Include="../cel-spec/tests/simple/testdata/*.textproto;Regression/*.textproto;Synthetic/*.textproto"
                  RepoPath="$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/'))"
                  BinaryRepoPath="$([System.IO.Path]::ChangeExtension($([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/')), '.binpb'))"
                  EncodedPath="$(CelSpecObj)$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/').Replace('/', '__')).binpb" />
    <CelSuiteFile Include="CelSpec/skips.md;Regression/skips.md;Regression/known-differences.md;../cel-spec/COMMIT"
                  RepoPath="$([MSBuild]::MakeRelative('$(CelRepoRoot)', '%(FullPath)').Replace('\', '/'))" />
    <CelProtoSource Include="$(CelProtoRoot)**/*.proto" />
    <EmbeddedResource Include="@(CelSuiteText);@(CelSuiteFile)" LogicalName="%(RepoPath)" />
  </ItemGroup>

  <!--
    The time zone data of the tests: the archive zoneinfo.zip of the pinned Go (docs/design/tests.md, "Time zone data"). One copy of the file; the
    other test projects embed it by a linked item, and Runner/ZoneInfoFile.cs reads it. It is used by tests only (NOTICE).
  -->
  <ItemGroup>
    <EmbeddedResource Include="ZoneInfo/zoneinfo.zip" LogicalName="tests/Great.Parts.Cel.Conformance/ZoneInfo/zoneinfo.zip" />
  </ItemGroup>

  <!--
    protoc reads each text file as a cel.expr.conformance.test.SimpleTestFile and writes the binary form. Expanded Any values and
    extensions resolve only when the test messages are inputs too, with the import path of the protos and the standard imports of
    Grpc.Tools. The stamp file is written after every file is encoded, so a failed run never looks up to date.
  -->
  <Target Name="EncodeCelSpecData"
          DependsOnTargets="Protobuf_ResolvePlatform"
          Inputs="@(CelSuiteText);@(CelProtoSource);$(MSBuildProjectFullPath)"
          Outputs="$(CelSpecStamp)">
    <MakeDir Directories="$(CelSpecObj)" />
    <PropertyGroup>
      <CelStandardImports>$(Protobuf_StandardImportsPath.TrimEnd('\').TrimEnd('/'))</CelStandardImports>
      <CelEncodeCommand>"$(Protobuf_ProtocFullPath)" --encode=cel.expr.conformance.test.SimpleTestFile -I"$(CelProtoDir)" -I"$(CelStandardImports)"</CelEncodeCommand>
      <CelEncodeInputs>"$(CelProtoDir)/cel/expr/conformance/test/simple.proto" "$(CelProtoDir)/cel/expr/conformance/proto2/test_all_types.proto" "$(CelProtoDir)/cel/expr/conformance/proto3/test_all_types.proto" "$(CelProtoDir)/cel/expr/conformance/proto2/test_all_types_extensions.proto"</CelEncodeInputs>
    </PropertyGroup>
    <Exec Command="$(CelEncodeCommand) $(CelEncodeInputs) &lt; &quot;%(CelSuiteText.FullPath)&quot; &gt; &quot;%(CelSuiteText.EncodedPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <WriteLinesToFile File="$(CelSpecStamp)" Lines="encoded" Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="@(CelSuiteText->'%(EncodedPath)')" />
      <FileWrites Include="$(CelSpecStamp)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedCelSpecData" DependsOnTargets="EncodeCelSpecData" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="%(CelSuiteText.EncodedPath)" LogicalName="%(CelSuiteText.BinaryRepoPath)" />
    </ItemGroup>
  </Target>

</Project>
