<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The test application of the trimming check: a Blazor WebAssembly application that uses Great.Parts.Cel, Great.Parts.Cel.Protobuf,
    Great.Parts.Cel.Filtering and Great.Parts.Cel.Policy. It is published in the default mode (IL trimming, no AOT compilation to
    WebAssembly) by the job wasm of ci.yml, and the publish must report 0 warnings IL2xxx and IL3xxx from the assemblies of the four
    packages. It is not run: the runner of the suites is tests/Great.Parts.Cel.Conformance.Wasm.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Wasm.App</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      The Blazor SDK suppresses the warnings of the trimmer analysis by default (SuppressTrimAnalysisWarnings is true), so a publish
      would report no IL2xxx and IL3xxx at all and the check of 0 warnings would pass for any code, the control example included.
    -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <!--
      IL2104 is the single warning that the trimmer gives for a whole assembly that is not marked trimmable and has trim warnings: here
      Microsoft.AspNetCore.Components and Microsoft.JSInterop of the framework, which the check does not judge. The four packages of the
      library are marked trimmable (IsAotCompatible), so their warnings are reported one by one, with their own codes, and stay counted.
      Warnings are errors here, so the single warning of the framework would fail the publish; the form is counted in eng/ratchet.json
      (IL2104: 1).
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <!--
    The runtime for WebAssembly does not run runtime-async methods, and the net11.0 build of the library has them (src/Directory.Build.targets).
    So the net11.0 application takes the variant of the four projects built without runtime async: the property GpcBrowserBuild=true
    (src/Directory.Build.props) is passed to every reference, so the projects that reference Great.Parts.Cel give the build one variant of
    it and not two. The net10.0 build has no runtime async and takes the usual build.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <LibraryBuildProperties>GpcBrowserBuild=true</LibraryBuildProperties>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" AdditionalProperties="$(LibraryBuildProperties)" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Protobuf/Great.Parts.Cel.Protobuf.csproj" AdditionalProperties="$(LibraryBuildProperties)" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Filtering/Great.Parts.Cel.Filtering.csproj" AdditionalProperties="$(LibraryBuildProperties)" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Policy/Great.Parts.Cel.Policy.csproj" AdditionalProperties="$(LibraryBuildProperties)" />
    <!--
      The generator of call sites runs in the compiler of this application as an analyzer and is not a reference of the assembly. The
      call of the simple entry with a class and a list of classes in CelSamples.cs needs the registration and the descriptions that it
      creates; without this reference the call has none, and the publish would not analyze the created code.
    -->
    <ProjectReference Include="../../src/Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The four assemblies are roots of the trimmer, so it analyzes all their code and not only the code the application calls: the publish
    reports an IL warning for every public capability that is not safe under trimming, which is what the check of the packages needs.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Great.Parts.Cel" />
    <TrimmerRootAssembly Include="Great.Parts.Cel.Protobuf" />
    <TrimmerRootAssembly Include="Great.Parts.Cel.Filtering" />
    <TrimmerRootAssembly Include="Great.Parts.Cel.Policy" />
  </ItemGroup>

  <!--
    The control example of the check of 0 IL warnings: with -p:IlControl=true the application has one call that is not safe under
    trimming (IlControl/IlWarning.cs), and its assembly is a root of the trimmer too, so the publish reports it. The job wasm of ci.yml
    publishes the application this way after the real publish and requires that the check turns red on it. Without the property the
    file is not part of the application.
  -->
  <ItemGroup>
    <Compile Remove="IlControl/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(IlControl)' == 'true'">
    <Compile Include="IlControl/IlWarning.cs" />
    <TrimmerRootAssembly Include="Great.Parts.Cel.Wasm.App" />
  </ItemGroup>

</Project>
