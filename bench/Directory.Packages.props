<Project>
  <!--
    Versions of the packages of the benchmark rig, pinned: a result of the rig names these versions, and a new version of a compared
    library is taken by a change of this file. The file replaces Directory.Packages.props of the repository root for the rig.
  -->
  <!-- The condition keeps the projects that BenchmarkDotNet generates for the runs of the cases outside the central management. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="'$(MSBuildProjectName)' == 'SpeedBench'">true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The benchmark runner. A preview: the release 0.15.8 cannot name .NET 11, the preview 0.16.0 can. Only the rig takes it. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- The libraries that are compared. -->
    <PackageVersion Include="Celly" Version="1.2.0" />
    <PackageVersion Include="DotnetCel" Version="1.0.7" />
    <PackageVersion Include="Cel.NET" Version="2.3.1" />
    <PackageVersion Include="Cel" Version="0.3.3" />
    <!-- protoc for Proto/order.proto, a build tool only. -->
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
  </ItemGroup>
</Project>
