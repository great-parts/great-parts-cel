<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro benchmarks of the limits of the speed-ups of the library: the search of a substring (.NET against Knuth–Morris–Pratt around 64
    code units), the build of the automaton of a pattern, and distinct and sets around the length 24 of a list. It references the
    library by project, not the package, and sees its internals (InternalsVisibleTo in src/Great.Parts.Cel). Not part of the solution,
    not run by ci.yml; bench.yml runs it with the rig (bench/run.mjs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Great.Parts.Cel.ThresholdBench</AssemblyName>
    <RootNamespace>ThresholdBench</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- BenchmarkDotNet needs this only for the optimization check of the referenced assemblies. -->
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
  </ItemGroup>

</Project>
