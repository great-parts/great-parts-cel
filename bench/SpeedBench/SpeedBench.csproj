<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Packages restore from packages.lock.json; the workflow restores in locked mode. The property is set here, not in Directory.Build.props, so the projects that BenchmarkDotNet generates write no lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Celly" />
    <PackageReference Include="DotnetCel" />
    <PackageReference Include="Cel.NET" />
    <!-- TELUS Cel: its namespace Cel is also the namespace of Cel.NET. -->
    <PackageReference Include="Cel" Aliases="TelusCel" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Great.Parts.Cel is the library of this repository, built from the sources: the rig measures the code of the commit it runs on.
    The source generator runs in the compiler of the rig as an analyzer (the type context BenchTypes, the anonymous objects of the
    simple entry) and is not a reference of the assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto/order.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
