<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Packages restore from packages.lock.json; the workflow restores in locked mode. The property is set here, not in Directory.Build.props, so the projects that BenchmarkDotNet generates write no lock file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    The verification under Native AOT: run.mjs with the runtime aot publishes this project with BenchAot=true and runs the native executable
    to verify every library in a Native AOT process (docs/design/eng-bench.md, "Native AOT"). The property is set on the command line of
    that publish only, so the restore of the workflow (locked mode) and every other build of the rig are unchanged. The measurement
    under Native AOT is made by the processes that BenchmarkDotNet publishes itself, from the project without this property; the
    executable of the publish has no mode "bench" (the constant BENCH_AOT), so BenchmarkDotNet is not compiled into it.
    The runtime identifier (BenchRuntimeIdentifier, for example linux-x64) is a property of this project, not the option -r of the
    command: a global runtime identifier would reach the restore of the library projects, whose lock files have no target for it.
  -->
  <PropertyGroup Condition="'$(BenchAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>$(BenchRuntimeIdentifier)</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);BENCH_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Celly" />
    <PackageReference Include="DotnetCel" />
    <PackageReference Include="Cel.NET" />
    <!-- TELUS Cel: its namespace Cel is also the namespace of Cel.NET. -->
    <PackageReference Include="Cel" Aliases="TelusCel" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Great.Parts.Cel is the library of this repository, built from the sources: the rig measures the code of the commit it runs on.
    The source generator runs in the compiler of the rig as an analyzer (the type context BenchTypes, the anonymous objects of the
    simple entry) and is not a reference of the assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto/order.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
