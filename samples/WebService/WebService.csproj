<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    These items build the packages from the sources of this repository. In your own project delete them and run
    `dotnet add package Great.Parts.Cel.AspNetCore`: the package brings Great.Parts.Cel.DependencyInjection and Great.Parts.Cel,
    and the source generator that Great.Parts.Cel carries.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.DependencyInjection/Great.Parts.Cel.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.AspNetCore/Great.Parts.Cel.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
