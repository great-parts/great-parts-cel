<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Policy</RootNamespace>
    <Title>Great.Parts.Cel.Policy: CEL Policy for Great.Parts.Cel</Title>
    <Description>CEL Policy for Great.Parts.Cel: read a policy in YAML (rules with variables, conditions, outputs, nested rules, first-match and aggregate semantics) and compile it in a CEL environment into one program, with every error at its line and column in the document.</Description>
    <PackageTags>$(PackageTags);policy;yaml</PackageTags>
    <!-- Trimming and Native AOT analyzers: IL2xxx and IL3xxx are build errors. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The package depends only on Great.Parts.Cel. YAML is read by the package's own reader, without a YAML library. The core
    gives this assembly no access to its internals: only the public API of the core is used.
  -->
  <ItemGroup>
    <ProjectReference Include="../Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The tests of the package and the conformance runner read the YAML reader of the package. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Policy.Tests" />
    <InternalsVisibleTo Include="Great.Parts.Cel.Conformance" />
  </ItemGroup>

  <!-- Banned APIs: every use is RS0030. -->
  <ItemGroup>
    <AdditionalFiles Include="../../eng/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The API concept list: every public type of the package has a row there. -->
  <ItemGroup>
    <AdditionalFiles Include="../../docs/api-concepts.md" Link="api-concepts.md" />
  </ItemGroup>

  <!-- Public API snapshot shared by both target frameworks; this package has no API specific to net11.0. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The notice file, the README of the package (PackageReadmeFile) and the instructions for AI coding agents (AGENTS.md, which
    the NuGet MCP server returns for the package) are in the root of the package.
  -->
  <ItemGroup>
    <None Include="../../NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.Policy.README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.Policy.AGENTS.md" Pack="true" PackagePath="AGENTS.md" Visible="false" />
  </ItemGroup>

</Project>
