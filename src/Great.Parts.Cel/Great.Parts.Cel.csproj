<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel</RootNamespace>
    <Title>Great.Parts.Cel: Common Expression Language for .NET</Title>
    <Description>Common Expression Language (CEL) for .NET 10 and .NET 11: compile and evaluate CEL expressions, with a source generator for typed objects and Native AOT support.</Description>
    <!-- Trimming and Native AOT analyzers: IL2xxx and IL3xxx are build errors. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The source generator runs in the compiler of the application as an analyzer and is not a reference of this assembly.
    PrivateAssets="all" keeps it out of the dependencies of the package; the target PackSourceGenerator below puts its
    assembly into the package.
  -->
  <ItemGroup>
    <ProjectReference Include="../Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Banned APIs: every use is RS0030. -->
  <ItemGroup>
    <AdditionalFiles Include="../../eng/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The API concept list: every public type of the package has a row there. -->
  <ItemGroup>
    <AdditionalFiles Include="../../docs/api-concepts.md" Link="api-concepts.md" />
  </ItemGroup>

  <!-- Public API snapshot shared by both target frameworks. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Additions for net10.0 only: the decimal API, new on this target in 2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <AdditionalFiles Include="PublicAPI/net10.0/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/net10.0/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Additions for net11.0 only: the decimal API. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <AdditionalFiles Include="PublicAPI/net11.0/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/net11.0/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Internal members are visible to the unit tests, the property tests, the suite runner and the benchmarks of the limits of the
    speed-ups (bench/ThresholdBench) only (docs/design/tests.md).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Tests" />
    <InternalsVisibleTo Include="Great.Parts.Cel.Properties" />
    <InternalsVisibleTo Include="Great.Parts.Cel.Conformance" />
    <InternalsVisibleTo Include="Great.Parts.Cel.ThresholdBench" />
  </ItemGroup>

  <!--
    The notice file, the README of the package (PackageReadmeFile) and the instructions for AI coding agents (AGENTS.md, which
    the NuGet MCP server returns for the package) are in the root of the package.
  -->
  <ItemGroup>
    <None Include="../../NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.AGENTS.md" Pack="true" PackagePath="AGENTS.md" Visible="false" />
  </ItemGroup>

  <!--
    The assembly of the source generator goes to analyzers/dotnet/cs/ of the package. The path comes from the project of
    the generator, which the build has already built, so the package needs no reference to the assembly.
  -->
  <Target Name="PackSourceGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SourceGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
