<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel</RootNamespace>
    <!-- Trimming and Native AOT analyzers: IL2xxx and IL3xxx are build errors. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The source generator runs in the compiler of the application as an analyzer and is not a reference of this assembly.
    PrivateAssets="all" keeps it out of the dependencies of the package; the target PackSourceGenerator below puts its
    assembly into the package.
  -->
  <ItemGroup>
    <ProjectReference Include="../Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Banned APIs: every use is RS0030. -->
  <ItemGroup>
    <AdditionalFiles Include="../../eng/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The API concept list: every public type of the package has a row there. -->
  <ItemGroup>
    <AdditionalFiles Include="../../docs/api-concepts.md" Link="api-concepts.md" />
  </ItemGroup>

  <!-- Public API snapshot shared by both target frameworks. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Additions for net11.0 only: the decimal API. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <AdditionalFiles Include="PublicAPI/net11.0/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/net11.0/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Internal members are visible to the unit tests and the property tests only (docs/design/tests.md). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Tests" />
    <InternalsVisibleTo Include="Great.Parts.Cel.Properties" />
  </ItemGroup>

  <!-- The notice file is in the root of the package. -->
  <ItemGroup>
    <None Include="../../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!--
    The assembly of the source generator goes to analyzers/dotnet/cs/ of the package. The path comes from the project of
    the generator, which the build has already built, so the package needs no reference to the assembly.
  -->
  <Target Name="PackSourceGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Great.Parts.Cel.Generator/Great.Parts.Cel.Generator.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_SourceGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
