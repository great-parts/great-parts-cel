<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Great.Parts.Cel.Filtering</RootNamespace>
    <Title>Great.Parts.Cel.Filtering: AIP-160 filters as type-checked CEL expressions</Title>
    <Description>Translates list filters written in the AIP-160 syntax (google.aip.dev/160) into CEL expressions of a Great.Parts.Cel environment and compiles them: errors with their place in the filter, evaluation on each item, the CEL tree for your own translation, Native AOT without reflection.</Description>
    <PackageTags>$(PackageTags);aip-160;filtering;filter</PackageTags>
    <!-- Trimming and Native AOT analyzers: IL2xxx and IL3xxx are build errors. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The package depends only on Great.Parts.Cel. The core gives this assembly no access to its internals: only the public API
    of the core is used - the description of the environment, the node factory of the parsed expression and the compilation
    of a tree. The AIP-160 parser and the translation are internal types of this assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="../Great.Parts.Cel/Great.Parts.Cel.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The tests of the package read the lexer and the parser of AIP-160, which are internal types of this assembly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Great.Parts.Cel.Filtering.Tests" />
  </ItemGroup>

  <!-- Banned APIs: every use is RS0030. -->
  <ItemGroup>
    <AdditionalFiles Include="../../eng/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The API concept list: every public type of the package has a row there. -->
  <ItemGroup>
    <AdditionalFiles Include="../../docs/api-concepts.md" Link="api-concepts.md" />
  </ItemGroup>

  <!-- Public API snapshot shared by both target frameworks; this package has no API specific to net11.0. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The notice file, the README of the package (PackageReadmeFile) and the instructions for AI coding agents (AGENTS.md, which
    the NuGet MCP server returns for the package) are in the root of the package.
  -->
  <ItemGroup>
    <None Include="../../NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.Filtering.README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="../../eng/packages/Great.Parts.Cel.Filtering.AGENTS.md" Pack="true" PackagePath="AGENTS.md" Visible="false" />
  </ItemGroup>

</Project>
